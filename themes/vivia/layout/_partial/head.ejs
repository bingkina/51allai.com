<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="theme-color" content="#7C3AED" data-light-color="#7C3AED" data-dark-color="#090D18">
  <meta name="format-detection" content="telephone=no">
  <script src="<%- url_for("/js/load-settings.js") %>"></script>

  <%- partial('google-analytics') %>
  <%- partial('baidu-analytics') %>
  <%- partial('gauges-analytics') %>

  <%
    // ---- Title ----
    var title = page.title;
    if (is_archive()){
      title = __('archive_a');
      if (is_month()) title += ': ' + page.year + '/' + page.month;
      else if (is_year()) title += ': ' + page.year;
    } else if (is_category()){
      title = __('category') + ': ' + page.category;
    } else if (is_tag()){
      title = __('tag') + ': ' + page.tag;
    }
    if (is_home() && page.current && page.current > 1) {
      title = '最新文章：第 ' + page.current + ' 页';
    }

    var titleText = (is_home() && (!page.current || page.current === 1))
      ? 'AI 科技资讯、智能体与大模型动态 | ' + config.title
      : ((title ? title + ' | ' : '') + config.title);
    var socialTitle = (is_home() && (!page.current || page.current === 1))
      ? config.title + '：AI 科技资讯、智能体与大模型动态'
      : (title || config.title);

    // ---- Description ----
    var pageDesc = '';
    if (page.description) {
      pageDesc = page.description;
    } else if (is_post() && page.excerpt) {
      pageDesc = strip_html(page.excerpt).replace(/\s+/g, ' ').trim().substring(0, 160);
    } else if (is_post() && page.content) {
      pageDesc = strip_html(page.content).replace(/\s+/g, ' ').trim().substring(0, 160);
    } else if (is_tag() && page.tag) {
      var tagDesc = '51AllAI 关于「' + page.tag + '」的最新报道与深度解读。';
      pageDesc = (page.current && page.current > 1) ? (tagDesc + ' 第 ' + page.current + ' 页。') : tagDesc;
    } else if (is_category() && page.category) {
      var catDesc = '51AllAI 「' + page.category + '」分类下的全部 AI 资讯文章。';
      pageDesc = (page.current && page.current > 1) ? (catDesc + ' 第 ' + page.current + ' 页。') : catDesc;
    } else if (is_archive()) {
      var archiveDesc = '';
      if (is_month()) {
        archiveDesc = '51AllAI ' + page.year + '年' + page.month + '月的 AI 科技新闻归档。';
      } else if (is_year()) {
        archiveDesc = '51AllAI ' + page.year + '年 AI 科技新闻归档。';
      } else {
        archiveDesc = '51AllAI 全部文章归档，按时间浏览 AI 科技动态。';
      }
      pageDesc = (page.current && page.current > 1) ? (archiveDesc + ' 第 ' + page.current + ' 页。') : archiveDesc;
    } else if (is_home()) {
      var homeDesc = config.description || '';
      pageDesc = (page.current && page.current > 1) ? (homeDesc + ' 第 ' + page.current + ' 页。') : homeDesc;
    } else if (page.path && (page.path === 'about/' || page.path === 'about/index.html' || page.title === 'about' || page.title === 'About')) {
      pageDesc = '关于 51AllAI 团队与我们的使命。';
    } else if (page.path && page.path.startsWith('search/')) {
      pageDesc = '在 51AllAI 站内搜索 AI 科技新闻与深度解读。';
    } else {
      pageDesc = config.description || '';
    }

    // ---- Canonical URL ----
    var siteRoot = config.url.replace(/\/$/, '');
    var canonicalUrl = siteRoot + url_for(page.path || '');
    var isAboutPage = page.path === 'about/' ||
      page.path === 'about/index.html' ||
      page.title === '关于 51AllAI';

    // 标签聚合页保留给站内浏览，但不参与搜索引擎索引。
    // 不在 robots.txt 屏蔽这些 URL，确保爬虫能够读取 noindex。
    var isTagIndexPage = page.layout === 'tags' ||
      page.path === 'tags/' ||
      page.path === 'tags/index.html';
    var isSearchPage = page.path && page.path.startsWith('search/');
    var isPaginatedPage = page.current && page.current > 1;
    var shouldNoindex = is_tag() || isTagIndexPage || isSearchPage || isPaginatedPage;

    // ---- OG Image ----
    // 优先级：首页最新文章 frontmatter.cover > 当前页 cover > photos > 正文首图 > 主题 default_cover > 头像
    // 文章页务必提取一张代表图，否则社交分享卡片只能 fallback 到头像，CTR 接近 0
    var siteIcon = config.url.replace(/\/$/, '') + url_for('/icon.png');
    var ogImage = '';
    var latestHomePost = (is_home() && page.posts && page.posts.length) ? page.posts.first() : null;
    var homeLeadImage = '';
    if (is_home() && (!page.current || page.current === 1) && latestHomePost) {
      var rawLeadImage = latestHomePost.cover || (latestHomePost.photos && latestHomePost.photos.length ? latestHomePost.photos[0] : null) || first_content_image(latestHomePost.content);
      if (rawLeadImage) {
        homeLeadImage = /^https?:\/\//.test(rawLeadImage) ? rawLeadImage : (config.url.replace(/\/$/, '') + url_for(rawLeadImage));
      }
    }
    if (is_home()) {
      // 首页预览统一使用站点图标，避免 Safari 起始页显示最新文章封面。
      ogImage = siteIcon;
    } else if (latestHomePost && latestHomePost.cover) {
      ogImage = /^https?:\/\//.test(latestHomePost.cover) ? latestHomePost.cover : (config.url.replace(/\/$/, '') + url_for(latestHomePost.cover));
    } else if (page.cover) {
      ogImage = /^https?:\/\//.test(page.cover) ? page.cover : (config.url.replace(/\/$/, '') + url_for(page.cover));
    } else if (page.photos && page.photos.length) {
      ogImage = page.photos[0];
    } else if (is_post()) {
      var firstImg = first_content_image(page.content);
      if (firstImg) {
        ogImage = /^https?:\/\//.test(firstImg) ? firstImg : (config.url.replace(/\/$/, '') + url_for(firstImg));
      }
    }
    if (!ogImage) {
      if (theme.default_cover) {
        ogImage = /^https?:\/\//.test(theme.default_cover) ? theme.default_cover : (config.url.replace(/\/$/, '') + url_for(theme.default_cover));
      } else if (theme.avatar) {
        ogImage = config.url.replace(/\/$/, '') + url_for(theme.avatar);
      }
    }

    // ---- JSON-LD graph ----
    // 所有实体复用稳定 @id，避免把站点、媒体机构和文章作者解析成不同对象。
    var organizationId = siteRoot + '/#organization';
    var websiteId = siteRoot + '/#website';
    var aboutUrl = siteRoot + '/about/';
    var socialProfiles = (theme.links || [])
      .map(function(link){ return link.url; })
      .filter(function(url){ return /^https?:\/\//.test(url || ''); });
    var organizationSchema = {
      '@type': 'NewsMediaOrganization',
      '@id': organizationId,
      name: config.title,
      alternateName: '51ALLAI',
      url: siteRoot + '/',
      logo: {
        '@type': 'ImageObject',
        url: siteIcon,
        contentUrl: siteIcon
      },
      description: config.description,
      sameAs: socialProfiles
    };
    var websiteSchema = {
      '@type': 'WebSite',
      '@id': websiteId,
      name: config.title,
      alternateName: config.subtitle,
      url: siteRoot + '/',
      description: config.description,
      inLanguage: 'zh-CN',
      publisher: {'@id': organizationId}
    };
    var schemaGraph = [organizationSchema, websiteSchema];

    if (is_post()) {
      var authorName = page.author || config.author;
      var category = page.categories && page.categories.length ? page.categories.data[0] : null;
      var articleSchema = {
        '@type': 'NewsArticle',
        '@id': canonicalUrl + '#article',
        headline: page.title,
        description: pageDesc,
        url: canonicalUrl,
        datePublished: page.date.toISOString(),
        dateModified: page.updated.toISOString(),
        inLanguage: 'zh-CN',
        isAccessibleForFree: true,
        author: {
          '@type': 'Organization',
          '@id': organizationId,
          name: authorName,
          url: aboutUrl
        },
        publisher: {'@id': organizationId},
        mainEntityOfPage: {'@id': canonicalUrl},
        isPartOf: {'@id': websiteId}
      };
      if (ogImage) articleSchema.image = [ogImage];
      if (page.tags && page.tags.length) {
        articleSchema.keywords = page.tags.map(function(tag){ return tag.name; });
      }
      if (category) articleSchema.articleSection = category.name;
      if (Array.isArray(page.sources)) {
        var citations = article_sources(page).map(function(source) {
          return {'@type': 'CreativeWork', name: source.name, url: source.url};
        });
        if (citations.length) articleSchema.citation = citations;
      }
      schemaGraph.push(articleSchema);

      var breadcrumbItems = [{
        '@type': 'ListItem',
        position: 1,
        name: '首页',
        item: siteRoot + '/'
      }];
      if (category) {
        breadcrumbItems.push({
          '@type': 'ListItem',
          position: 2,
          name: category.name,
          item: siteRoot + url_for('/categories/' + category.slug + '/')
        });
      }
      breadcrumbItems.push({
        '@type': 'ListItem',
        position: breadcrumbItems.length + 1,
        name: page.title,
        item: canonicalUrl
      });
      schemaGraph.push({
        '@type': 'BreadcrumbList',
        '@id': canonicalUrl + '#breadcrumb',
        itemListElement: breadcrumbItems
      });
    } else {
      var isTopicPage = page.layout === 'topic';
      var isTopicIndexPage = page.layout === 'topic-index';
      var pageType = isAboutPage ? 'AboutPage' : ((is_home() || is_category() || is_archive() || isTopicPage || isTopicIndexPage) ? 'CollectionPage' : 'WebPage');
      var pageSchema = {
        '@type': pageType,
        '@id': canonicalUrl + '#webpage',
        name: socialTitle,
        description: pageDesc,
        url: canonicalUrl,
        inLanguage: 'zh-CN',
        isPartOf: {'@id': websiteId},
        publisher: {'@id': organizationId}
      };
      if (isAboutPage) pageSchema.mainEntity = {'@id': organizationId};
      schemaGraph.push(pageSchema);

      var collectionPosts = isTopicPage ? topic_posts(page.topic_tags, 20) : ((page.posts && (is_home() || is_category())) ? page.posts.toArray() : []);
      if (!shouldNoindex && collectionPosts.length) {
        var listItems = [];
        collectionPosts.forEach(function(post, index){
          listItems.push({
            '@type': 'ListItem',
            position: index + 1,
            url: siteRoot + url_for(post.path),
            name: post.title
          });
        });
        schemaGraph.push({
          '@type': 'ItemList',
          '@id': canonicalUrl + '#articles',
          name: socialTitle,
          numberOfItems: listItems.length,
          itemListElement: listItems
        });
      }
    }

    var structuredData = JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': schemaGraph
    }).replace(/</g, '\\u003c');
  %>

  <title><%= titleText %></title>
  <meta name="description" content="<%= pageDesc %>">
  <% if (is_post() && page.tags && page.tags.length) { %>
    <meta name="keywords" content="<%= page.tags.map(function(t){return t.name}).join(', ') %>">
  <% } else if (config.keywords) { %>
    <meta name="keywords" content="<%= config.keywords %>">
  <% } %>
  <meta name="author" content="<%= config.author %>">
  <% if (shouldNoindex) { %>
    <meta name="robots" content="noindex, follow">
  <% } else { %>
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <% } %>
  <% if (homeLeadImage) { %>
    <link rel="preload" as="image" href="<%= homeLeadImage %>" fetchpriority="high">
  <% } %>

  <link rel="canonical" href="<%= canonicalUrl %>">

  <% if (page.prev && page.prev_link) { %>
    <link rel="prev" href="<%= config.url.replace(/\/$/, '') + url_for(page.prev_link) %>">
  <% } %>
  <% if (page.next && page.next_link) { %>
    <link rel="next" href="<%= config.url.replace(/\/$/, '') + url_for(page.next_link) %>">
  <% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= socialTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:locale" content="zh_CN">
  <% if (ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>">
  <% } %>
  <% if (is_post()) { %>
    <meta property="article:published_time" content="<%= page.date.toISOString() %>">
    <meta property="article:modified_time" content="<%= page.updated.toISOString() %>">
    <meta property="article:author" content="<%= page.author || config.author %>">
    <% if (page.categories && page.categories.length) { %>
      <meta property="article:section" content="<%= page.categories.data[0].name %>">
    <% } %>
    <% if (page.tags && page.tags.length) { %>
      <% page.tags.each(function(tag){ %>
        <meta property="article:tag" content="<%= tag.name %>">
      <% }) %>
    <% } %>
  <% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="<%= ogImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= socialTitle %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <% if (ogImage) { %>
    <meta name="twitter:image" content="<%= ogImage %>">
  <% } %>

  <!-- JSON-LD structured data -->
  <script type="application/ld+json"><%- structuredData %></script>

  <!-- Resource hints: speed up external CDN handshake -->
  <link rel="preconnect" href="https://cdn.staticfile.org" crossorigin>
  <link rel="dns-prefetch" href="https://cdn.staticfile.org">
  <link rel="preconnect" href="https://images.51allai.com" crossorigin>
  <link rel="dns-prefetch" href="https://images.51allai.com">
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
  <link rel="dns-prefetch" href="https://hm.baidu.com">

  <!-- Font Awesome: 非阻塞加载，避免阻塞首屏 FCP 与 LCP 绘制 -->
  <link rel="preload" href="https://cdn.staticfile.org/font-awesome/6.4.2/css/fontawesome.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <link rel="preload" href="https://cdn.staticfile.org/font-awesome/6.4.2/css/brands.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <link rel="preload" href="https://cdn.staticfile.org/font-awesome/6.4.2/css/solid.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link rel="stylesheet" href="https://cdn.staticfile.org/font-awesome/6.4.2/css/fontawesome.min.css">
    <link rel="stylesheet" href="https://cdn.staticfile.org/font-awesome/6.4.2/css/brands.min.css">
    <link rel="stylesheet" href="https://cdn.staticfile.org/font-awesome/6.4.2/css/solid.min.css">
  </noscript>

  <% if (config.feed) { %>
    <%- feed_tag() %>
  <% } else if (theme.rss) { %>
    <%- feed_tag(theme.rss) %>
  <% } %>

  <link rel="icon" href="<%= siteIcon %>" type="image/png" sizes="any">
  <link rel="shortcut icon" href="<%= siteIcon %>" type="image/png">
  <link rel="apple-touch-icon" href="<%= siteIcon %>">

  <%- css('css/style') %>

  <!-- Google AdSense -->
  <meta name="google-adsense-account" content="ca-pub-2636176262045069">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2636176262045069"
     crossorigin="anonymous"></script>
</head>
