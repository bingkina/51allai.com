<footer id="footer">
  <% if (theme.sidebar === 'bottom'){ %>
    <%- partial('_partial/sidebar') %>
  <% } %>
  <div id="footer-info" class="inner">
    <% if (theme.copyright){ %>
      <%- render(theme.copyright, 'pug'); %>
    <% } %>
    <strong><%= theme.author || config.author || config.title %></strong>
    <span>记录 AI 的现在，理解技术的下一步。</span>
    <small><span class="footer-copyright">&copy; <%= date(new Date(), 'YYYY') %></span><span class="footer-separator" aria-hidden="true"> · </span><a href="<%- url_for('/about/') %>">关于 51AllAI</a><span class="footer-separator" aria-hidden="true"> · </span><a href="<%- url_for('/topics/') %>">精选专题</a><span class="footer-separator" aria-hidden="true"> · </span><a href="<%- url_for('/atom.xml') %>">RSS 订阅</a><span class="footer-separator" aria-hidden="true"> · </span><a href="<%- url_for('/sitemap.xml') %>">Sitemap</a></small>
  </div>
</footer>
